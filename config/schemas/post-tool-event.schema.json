{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/post-tool-event.schema.json",
  "title": "Trusted post-tool event",
  "type": "object",
  "required": [
    "schema_version",
    "event_type",
    "run_id",
    "tool_call_id",
    "tool_id",
    "arguments",
    "requested_at",
    "actor",
    "started_at",
    "completed_at",
    "status",
    "output",
    "error",
    "side_effects"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_type": {"const": "post_tool"},
    "run_id": {"type": "string", "minLength": 1},
    "tool_call_id": {"type": "string", "minLength": 1},
    "tool_id": {"type": "string", "minLength": 1},
    "arguments": {"type": "object"},
    "requested_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["succeeded", "failed", "partial"]},
    "output": {},
    "error": {"type": ["string", "null"]},
    "side_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "target", "description", "reversible"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "reversible": {"type": ["boolean", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {"properties": {"error": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["failed", "partial"]}}},
      "then": {"properties": {"error": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "partial"}}},
      "then": {"properties": {"side_effects": {"minItems": 1}}}
    }
  ],
  "additionalProperties": false
}
