{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/approval.schema.json",
  "title": "Bound tool-call approval",
  "type": "object",
  "required": [
    "schema_version",
    "approval_id",
    "run_id",
    "tool_call_id",
    "tool_id",
    "arguments_digest",
    "granted_at",
    "granted_by",
    "single_use",
    "consumed_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "tool_call_id": {"type": "string", "minLength": 1},
    "tool_id": {"type": "string", "minLength": 1},
    "arguments_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "granted_at": {"type": "string", "format": "date-time"},
    "granted_by": {"type": "string", "minLength": 1},
    "single_use": {"const": true},
    "consumed_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
