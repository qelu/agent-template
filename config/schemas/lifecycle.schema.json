{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/lifecycle.schema.json",
  "title": "Executable lifecycle configuration",
  "type": "object",
  "required": ["version", "state_directory", "limits"],
  "properties": {
    "version": {"const": "1.0"},
    "state_directory": {
      "type": "string",
      "pattern": "^runtime/(?!.*(?:^|/)[.][.](?:/|$))[A-Za-z0-9._/-]+$"
    },
    "limits": {
      "type": "object",
      "required": [
        "max_model_turns",
        "max_tool_calls",
        "max_retries",
        "run_timeout_seconds",
        "tool_timeout_seconds"
      ],
      "properties": {
        "max_model_turns": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 100},
        "run_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "tool_timeout_seconds": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
