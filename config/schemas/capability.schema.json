{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/capability.schema.json",
  "title": "Agent capability registry",
  "type": "object",
  "required": ["version", "capabilities"],
  "properties": {
    "version": {"const": "3.0"},
    "capabilities": {
      "type": "array",
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "dependency": {
      "type": "object",
      "required": ["id", "minimum_version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "minimum_version": {"$ref": "#/$defs/semver"}
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": [
        "id", "type", "version", "status", "path", "description",
        "risk_level", "hosts", "requires", "evaluation"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "type": {"enum": ["skill", "workflow", "hook", "runbook", "validator", "mcp-server"]},
        "version": {"$ref": "#/$defs/semver"},
        "status": {"enum": ["proposed", "active", "disabled", "deprecated"]},
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "description": {"type": "string", "minLength": 10},
        "risk_level": {"enum": ["low", "medium", "high", "critical"]},
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["portable", "codex", "claude-code", "antigravity"]}
        },
        "requires": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
        "evaluation": {
          "oneOf": [
            {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
