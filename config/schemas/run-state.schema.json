{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/run-state.schema.json",
  "title": "Persistent executable lifecycle state",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "actor",
    "status",
    "revision",
    "created_at",
    "updated_at",
    "deadline_at",
    "limits",
    "usage",
    "plans",
    "active_plan_revision",
    "validation_round",
    "pending_call",
    "attempts",
    "side_effects",
    "validation_evidence",
    "transitions",
    "terminal_reason"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "created",
        "inspecting",
        "ready",
        "awaiting_approval",
        "executing",
        "validating",
        "completed",
        "failed",
        "cancelled",
        "blocked"
      ]
    },
    "revision": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "deadline_at": {"type": "string", "format": "date-time"},
    "limits": {"$ref": "#/$defs/limits"},
    "usage": {
      "type": "object",
      "required": ["model_turns", "tool_calls", "retries"],
      "properties": {
        "model_turns": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "revision",
          "digest",
          "summary",
          "status",
          "approval_id",
          "created_at",
          "approved_at",
          "actions"
        ],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "summary": {"type": "string", "minLength": 1},
          "status": {"enum": ["draft", "approved", "superseded"]},
          "approval_id": {"type": ["string", "null"]},
          "created_at": {"type": "string", "format": "date-time"},
          "approved_at": {"type": ["string", "null"], "format": "date-time"},
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["tool_id", "arguments_digest", "used"],
              "properties": {
                "tool_id": {"type": "string", "minLength": 1},
                "arguments_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "used": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "active_plan_revision": {"type": ["integer", "null"], "minimum": 1},
    "validation_round": {"type": "integer", "minimum": 0},
    "pending_call": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/pre_tool_event"}
      ]
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "attempt_id",
          "tool_call_id",
          "tool_id",
          "arguments_digest",
          "idempotency_key",
          "attempt_number",
          "status",
          "started_at",
          "completed_at",
          "error"
        ],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "tool_call_id": {"type": "string", "minLength": 1},
          "tool_id": {"type": "string", "minLength": 1},
          "arguments_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "attempt_number": {"type": "integer", "minimum": 1},
          "status": {"enum": ["started", "succeeded", "failed", "partial", "timed_out"]},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": ["string", "null"], "format": "date-time"},
          "error": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool_call_id", "kind", "target", "description", "reversible"],
        "properties": {
          "tool_call_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "reversible": {"type": ["boolean", "null"]}
        },
        "additionalProperties": false
      }
    },
    "validation_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "validation_round",
          "validator",
          "summary",
          "passed",
          "recorded_at"
        ],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "validation_round": {"type": "integer", "minimum": 1},
          "validator": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "recorded_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "at", "reason"],
        "properties": {
          "from": {"type": ["string", "null"]},
          "to": {"type": "string", "minLength": 1},
          "at": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "terminal_reason": {"type": ["string", "null"]}
  },
  "$defs": {
    "pre_tool_event": {
      "type": "object",
      "required": [
        "schema_version",
        "event_type",
        "run_id",
        "tool_call_id",
        "tool_id",
        "arguments",
        "requested_at",
        "actor"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "event_type": {"const": "pre_tool"},
        "run_id": {"type": "string", "minLength": 1},
        "tool_call_id": {"type": "string", "minLength": 1},
        "tool_id": {"type": "string", "minLength": 1},
        "arguments": {"type": "object"},
        "requested_at": {"type": "string", "format": "date-time"},
        "actor": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "max_model_turns",
        "max_tool_calls",
        "max_retries",
        "run_timeout_seconds",
        "tool_timeout_seconds"
      ],
      "properties": {
        "max_model_turns": {"type": "integer", "minimum": 1},
        "max_tool_calls": {"type": "integer", "minimum": 1},
        "max_retries": {"type": "integer", "minimum": 0},
        "run_timeout_seconds": {"type": "integer", "minimum": 1},
        "tool_timeout_seconds": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["completed", "failed", "cancelled", "blocked"]}}},
      "then": {"properties": {"terminal_reason": {"type": "string", "minLength": 1}}},
      "else": {"properties": {"terminal_reason": {"type": "null"}}}
    }
  ],
  "additionalProperties": false
}
