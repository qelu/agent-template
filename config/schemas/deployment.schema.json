{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/deployment.schema.json",
  "title": "Agent deployment profile",
  "type": "object",
  "required": ["version", "host", "documentation", "runtime"],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "host": {
      "enum": ["portable", "codex", "claude-code", "gemini-cli"]
    },
    "documentation": {
      "type": "object",
      "required": ["provider", "mode"],
      "properties": {
        "provider": {
          "enum": ["none", "openai", "anthropic", "gemini"]
        },
        "mode": {
          "enum": ["none", "mcp", "skill"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"provider": {"const": "none"}}},
          "then": {"properties": {"mode": {"const": "none"}}}
        },
        {
          "if": {"properties": {"provider": {"enum": ["openai", "gemini"]}}},
          "then": {"properties": {"mode": {"const": "mcp"}}}
        },
        {
          "if": {"properties": {"provider": {"const": "anthropic"}}},
          "then": {"properties": {"mode": {"const": "skill"}}}
        }
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["adapter"],
      "properties": {
        "adapter": {
          "enum": [
            "none",
            "reference",
            "openai-agents",
            "claude-agent-sdk",
            "google-adk"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "documentation": {
            "properties": {"mode": {"const": "mcp"}}
          }
        }
      },
      "then": {
        "properties": {
          "host": {"enum": ["codex", "claude-code", "gemini-cli"]}
        }
      }
    }
  ],
  "additionalProperties": false
}
