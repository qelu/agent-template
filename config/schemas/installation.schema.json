{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/installation.schema.json",
  "title": "Agent harness installation receipt",
  "type": "object",
  "required": [
    "schema_version",
    "agent_id",
    "host",
    "execution",
    "run_identity",
    "documentation_provider",
    "capabilities",
    "environment",
    "external_commands",
    "validation"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "agent_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "host": {"enum": ["portable", "codex", "claude-code", "antigravity"]},
    "execution": {"const": "host-native"},
    "run_identity": {"const": "host-session"},
    "documentation_provider": {"enum": ["none", "openai", "anthropic", "gemini"]},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "project_dependencies_installed",
        "development_tools",
        "security_tools",
        "host_tool_install_requested"
      ],
      "properties": {
        "python": {"type": "string", "pattern": "^3\\.(11|12|13)$"},
        "project_dependencies_installed": {"type": "boolean"},
        "development_tools": {"type": "boolean"},
        "security_tools": {"type": "boolean"},
        "host_tool_install_requested": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "external_commands": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "validation": {"enum": ["pending", "passed"]}
  },
  "additionalProperties": false
}
