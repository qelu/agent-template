{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/qelu/agent-template/main/config/schemas/installation.schema.json",
  "title": "Agent harness installation receipt",
  "type": "object",
  "required": [
    "schema_version",
    "agent_id",
    "host",
    "execution",
    "run_identity",
    "documentation_provider",
    "capabilities",
    "template",
    "skill_imports",
    "environment",
    "external_commands",
    "validation"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "agent_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "host": {"enum": ["portable", "codex", "claude-code", "antigravity"]},
    "execution": {"const": "host-native"},
    "run_identity": {"const": "host-session"},
    "documentation_provider": {"enum": ["none", "openai", "anthropic", "gemini"]},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "bundles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "integrations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "kind", "authentication"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "kind": {"enum": ["remote-mcp", "remote-mcp-suite", "local-mcp", "official-cli", "plugin"]},
          "authentication": {"enum": ["pending", "not-required", "verified"]}
        },
        "additionalProperties": false
      }
    },
    "template": {
      "type": "object",
      "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "skill_imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "imported_at", "source", "audit_verdict"],
        "properties": {
          "skill": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "imported_at": {"type": "string", "minLength": 1},
          "source": {"type": "object"},
          "audit_verdict": {"enum": ["pass", "pass-with-warnings"]}
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "project_dependencies_installed",
        "development_tools",
        "security_tools",
        "host_tool_install_requested"
      ],
      "properties": {
        "python": {"type": "string", "pattern": "^3\\.(11|12|13|14)$"},
        "project_dependencies_installed": {"type": "boolean"},
        "development_tools": {"type": "boolean"},
        "security_tools": {"type": "boolean"},
        "host_tool_install_requested": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "external_commands": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "integration_setup": {
      "type": "object",
      "properties": {
        "google_workspace": {
          "type": "object",
          "required": [
            "client_configured",
            "client_target",
            "mcp_package",
            "services",
            "readonly",
            "authentication"
          ],
          "properties": {
            "client_configured": {"const": true},
            "client_target": {"type": "string", "minLength": 1},
            "mcp_package": {"type": "string", "minLength": 1},
            "services": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "readonly": {"type": "boolean"},
            "authentication": {"enum": ["pending", "verified"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "validation": {"enum": ["pending", "passed"]}
  },
  "additionalProperties": false
}
