{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/tool-policy.schema.json",
  "title": "Trusted tool policy registry",
  "type": "object",
  "required": ["version", "tools"],
  "properties": {
    "version": {"const": "1.0"},
    "tools": {
      "type": "array",
      "items": {"$ref": "#/$defs/tool"}
    }
  },
  "$defs": {
    "action_class": {
      "enum": [
        "read_only",
        "reversible_local_change",
        "destructive_change",
        "external_side_effect",
        "permission_expansion"
      ]
    },
    "risk_level": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "argument_field": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "rule": {
      "type": "object",
      "required": ["field", "equals", "action_class", "risk_level", "approval"],
      "properties": {
        "field": {"$ref": "#/$defs/argument_field"},
        "equals": {},
        "action_class": {"$ref": "#/$defs/action_class"},
        "risk_level": {"$ref": "#/$defs/risk_level"},
        "approval": {"enum": ["inherit", "always"]}
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": [
        "id",
        "action_class",
        "risk_level",
        "approval",
        "argument_rules",
        "filesystem",
        "shell",
        "network",
        "private_data_egress",
        "untrusted_output"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "action_class": {"$ref": "#/$defs/action_class"},
        "risk_level": {"$ref": "#/$defs/risk_level"},
        "approval": {"enum": ["inherit", "always"]},
        "argument_rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/rule"}
        },
        "filesystem": {
          "type": "object",
          "required": ["access", "path_arguments", "require_exact_targets"],
          "properties": {
            "access": {"enum": ["none", "read", "write", "destructive"]},
            "path_arguments": {
              "type": "array",
              "items": {"$ref": "#/$defs/argument_field"},
              "uniqueItems": true
            },
            "require_exact_targets": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "shell": {
          "type": "object",
          "required": ["access", "command_arguments"],
          "properties": {
            "access": {"enum": ["none", "execute"]},
            "command_arguments": {
              "type": "array",
              "items": {"$ref": "#/$defs/argument_field"},
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "required": ["access", "host_arguments", "allowed_hosts"],
          "properties": {
            "access": {"enum": ["none", "outbound"]},
            "host_arguments": {
              "type": "array",
              "items": {"$ref": "#/$defs/argument_field"},
              "uniqueItems": true
            },
            "allowed_hosts": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "private_data_egress": {"enum": ["deny", "allow_with_approval"]},
        "untrusted_output": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
