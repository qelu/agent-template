{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/policy.schema.json",
  "title": "Trusted authorization policy",
  "type": "object",
  "required": ["version", "scope", "authorization", "safety", "secrets", "audit"],
  "properties": {
    "version": {"const": "1.0"},
    "scope": {
      "type": "object",
      "required": ["read_roots", "write_roots", "denied_roots"],
      "properties": {
        "read_roots": {"$ref": "#/$defs/roots"},
        "write_roots": {"$ref": "#/$defs/roots"},
        "denied_roots": {"$ref": "#/$defs/roots"}
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": [
        "read_only",
        "reversible_local_change",
        "destructive_change",
        "external_side_effect",
        "permission_expansion"
      ],
      "properties": {
        "read_only": {"$ref": "#/$defs/authorization"},
        "reversible_local_change": {"$ref": "#/$defs/authorization"},
        "destructive_change": {"$ref": "#/$defs/authorization"},
        "external_side_effect": {"$ref": "#/$defs/authorization"},
        "permission_expansion": {"$ref": "#/$defs/authorization"}
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": [
        "deny_shell_patterns",
        "require_exact_target_for_destructive_actions",
        "prefer_recoverable_deletion"
      ],
      "properties": {
        "deny_shell_patterns": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "require_exact_target_for_destructive_actions": {"const": true},
        "prefer_recoverable_deletion": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "required": ["store_in_repository", "denied_path_markers", "allowed_references"],
      "properties": {
        "store_in_repository": {"const": false},
        "denied_path_markers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "allowed_references": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["enabled", "log_arguments", "redact_keys"],
      "properties": {
        "enabled": {"type": "boolean"},
        "log_arguments": {"type": "boolean"},
        "redact_keys": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "roots": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "authorization": {
      "enum": ["autonomous", "explicit_approval"]
    }
  },
  "additionalProperties": false
}
